<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.coucou.login-theme">
    <description>Change the login screen theme</description>
    <description xml:lang="es">Cambiar el tema de la pantalla de inicio de sesión</description>
    <message>Coucou needs your password to change the login screen.</message>
    <message xml:lang="es">Coucou necesita tu contraseña para cambiar la pantalla de inicio de sesión.</message>
    <icon_name>preferences-system-login</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/coucou/login-theme</annotate>
  </action>
</policyconfig>
