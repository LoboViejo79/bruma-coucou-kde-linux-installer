+// ---- kde-win11 -------------------------------------------------------------------------------
+// Caja de búsqueda como la del Explorador de Windows 11: se escribe en la barra superior y busca por
+// nombre en la carpeta actual (filenamesearch) sin abrir la barra de búsqueda inferior de Dolphin.
+
+void DolphinMainWindow::win11SetupSearchField()
+{
+    m_win11SearchField = new QLineEdit(this);
+    m_win11SearchField->setObjectName(QStringLiteral("win11SearchField"));
+    m_win11SearchField->setClearButtonEnabled(true);
+    m_win11SearchField->addAction(QIcon::fromTheme(QStringLiteral("search")), QLineEdit::TrailingPosition);
+    m_win11SearchField->setMinimumWidth(220);
+    m_win11SearchField->setMaximumWidth(320);
+
+    m_win11SearchTimer = new QTimer(this);
+    m_win11SearchTimer->setSingleShot(true);
+    m_win11SearchTimer->setInterval(350); // busca al dejar de escribir, como Windows
+    connect(m_win11SearchTimer, &QTimer::timeout, this, &DolphinMainWindow::win11Search);
+    connect(m_win11SearchField, &QLineEdit::textEdited, m_win11SearchTimer, qOverload<>(&QTimer::start));
+    connect(m_win11SearchField, &QLineEdit::returnPressed, this, [this]() {
+        m_win11SearchTimer->stop();
+        win11Search();
+    });
+    // Esc: borra la búsqueda y vuelve a la carpeta
+    auto *escape = new QAction(m_win11SearchField);
+    escape->setShortcut(Qt::Key_Escape);
+    escape->setShortcutContext(Qt::WidgetShortcut);
+    m_win11SearchField->addAction(escape);
+    connect(escape, &QAction::triggered, this, [this]() {
+        m_win11SearchField->clear();
+        win11Search();
+        m_activeViewContainer->view()->setFocus();
+    });
+
+    auto *action = new QWidgetAction(this);
+    action->setText(i18nc("@action:intoolbar", "Search"));
+    action->setDefaultWidget(m_win11SearchField);
+    actionCollection()->addAction(QStringLiteral("search_field"), action);
+
+    connect(this, &DolphinMainWindow::urlChanged, this, &DolphinMainWindow::win11UrlChanged);
+}
+
+void DolphinMainWindow::win11Search()
+{
+    if (!m_activeViewContainer) {
+        return;
+    }
+    const QString term = m_win11SearchField->text().trimmed();
+    const bool searching = Search::isSupportedSearchScheme(m_activeViewContainer->url().scheme());
+    if (term.isEmpty()) {
+        if (searching && m_win11SearchBase.isValid()) {
+            m_activeViewContainer->setUrl(m_win11SearchBase);
+        }
+        return;
+    }
+    const QUrl base = m_win11SearchBase.isValid() ? m_win11SearchBase : m_activeViewContainer->url();
+    Search::DolphinQuery query(base, base);
+    query.setSearchTool(Search::SearchTool::Filenamesearch);
+    query.setSearchThrough(Search::SearchThrough::FileNames);
+    query.setSearchPath(base);
+    query.setSearchTerm(term);
+    m_activeViewContainer->setGrabFocusOnUrlChange(false); // seguir escribiendo en la caja
+    m_activeViewContainer->setUrl(query.toUrl());
+    m_activeViewContainer->setGrabFocusOnUrlChange(true);
+}
+
+void DolphinMainWindow::win11UrlChanged(const QUrl &url)
+{
+    if (!m_win11SearchField) {
+        return;
+    }
+    if (Search::isSupportedSearchScheme(url.scheme())) {
+        // p. ej. al volver atrás a una búsqueda: la caja muestra lo buscado
+        const Search::DolphinQuery query(url, m_win11SearchBase);
+        if (!m_win11SearchField->hasFocus()) {
+            m_win11SearchField->setText(query.searchTerm());
+        }
+        if (query.searchPath().isValid()) {
+            m_win11SearchBase = query.searchPath();
+        }
+        return;
+    }
+    m_win11SearchBase = url;
+    m_win11SearchField->clear();
+    QString name = m_activeViewContainer ? m_activeViewContainer->caption() : url.fileName();
+    m_win11SearchField->setPlaceholderText(QStringLiteral("Buscar en %1").arg(name)); // como Windows
+}
