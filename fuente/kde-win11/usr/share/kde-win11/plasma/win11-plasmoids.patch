diff --git a/win11tray/contents/ui/components/MediaCard.qml b/win11tray/contents/ui/components/MediaCard.qml
new file mode 100644
index 0000000..774fc38
--- /dev/null
+++ b/win11tray/contents/ui/components/MediaCard.qml
@@ -0,0 +1,129 @@
+/*
+    MediaCard — tarjeta multimedia encima de los ajustes rápidos, como en Windows 11
+    (kde-win11): app que reproduce y ">", título y artista con la carátula a la
+    derecha, y anterior / reproducir-pausa / siguiente. Solo se ve si hay un
+    reproductor MPRIS (navegador, Spotify, Haruna…).
+*/
+import QtQuick
+import QtQuick.Layouts
+import org.kde.plasma.private.mpris as Mpris
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.components as PlasmaComponents3
+
+Rectangle {
+    id: card
+
+    property real scale: 1
+    // false: sin fondo ni borde propios (dentro de su propia ventana, que ya pone el fondo)
+    property bool framed: true
+    signal openPage()
+
+    Mpris.Mpris2Model {
+        id: mprisModel
+    }
+
+    // Reproductor actual (el que suena; si ninguno, el último usado) o null si no hay ninguno
+    readonly property var player: mprisModel.currentPlayer ?? null
+    readonly property bool playing: player !== null && player.playbackStatus === Mpris.PlaybackStatus.Playing
+
+    implicitHeight: col.implicitHeight + 24 * scale
+    radius: 8
+    color: framed ? Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.05) : "transparent"
+    border.width: framed ? 1 : 0
+    border.color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.08)
+
+    ColumnLayout {
+        id: col
+        anchors.fill: parent
+        anchors.margins: 12 * card.scale
+        spacing: 10 * card.scale
+
+        // App que reproduce y ">" (abre la página multimedia)
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: 8
+            Kirigami.Icon {
+                Layout.preferredWidth: 16
+                Layout.preferredHeight: 16
+                // Icono de la app (p. ej. el de Firefox) por su .desktop; si no, el del reproductor
+                source: card.player ? (card.player.desktopEntry || card.player.iconName || "media-playback-start") : ""
+            }
+            PlasmaComponents3.Label {
+                Layout.fillWidth: true
+                text: card.player ? card.player.identity : ""
+                font.pixelSize: 12
+                elide: Text.ElideRight
+            }
+            PlasmaComponents3.ToolButton {
+                icon.name: "go-next"
+                display: PlasmaComponents3.AbstractButton.IconOnly
+                text: i18n("Media")
+                onClicked: card.openPage()
+            }
+        }
+
+        // Título y artista; carátula a la derecha
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: 10
+            ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 2
+                PlasmaComponents3.Label {
+                    Layout.fillWidth: true
+                    text: card.player ? (card.player.track || i18n("Unknown track")) : ""
+                    font.pixelSize: 14
+                    font.weight: Font.DemiBold
+                    elide: Text.ElideRight
+                }
+                PlasmaComponents3.Label {
+                    Layout.fillWidth: true
+                    text: card.player ? (card.player.artist || "") : ""
+                    visible: text.length > 0
+                    opacity: 0.7
+                    font.pixelSize: 12
+                    elide: Text.ElideRight
+                }
+            }
+            Image {
+                Layout.preferredWidth: 64 * card.scale
+                Layout.preferredHeight: 40 * card.scale
+                visible: card.player !== null && !!card.player.artUrl && String(card.player.artUrl).length > 0
+                source: card.player ? card.player.artUrl : ""
+                fillMode: Image.PreserveAspectCrop
+                layer.enabled: true
+                layer.effect: Kirigami.ShadowedTexture { radius: 4 }
+            }
+        }
+
+        // Controles
+        RowLayout {
+            Layout.alignment: Qt.AlignHCenter
+            spacing: 24 * card.scale
+            PlasmaComponents3.ToolButton {
+                icon.name: "media-skip-backward"
+                icon.width: 20; icon.height: 20
+                display: PlasmaComponents3.AbstractButton.IconOnly
+                text: i18n("Previous")
+                enabled: card.player !== null && card.player.canGoPrevious
+                onClicked: card.player.Previous()
+            }
+            PlasmaComponents3.ToolButton {
+                icon.name: card.playing ? "media-playback-pause" : "media-playback-start"
+                icon.width: 24; icon.height: 24
+                display: PlasmaComponents3.AbstractButton.IconOnly
+                text: card.playing ? i18n("Pause") : i18n("Play")
+                enabled: card.player !== null && (card.player.canPlay || card.player.canPause)
+                onClicked: card.playing ? card.player.Pause() : card.player.Play()
+            }
+            PlasmaComponents3.ToolButton {
+                icon.name: "media-skip-forward"
+                icon.width: 20; icon.height: 20
+                display: PlasmaComponents3.AbstractButton.IconOnly
+                text: i18n("Next")
+                enabled: card.player !== null && card.player.canGoNext
+                onClicked: card.player.Next()
+            }
+        }
+    }
+}
