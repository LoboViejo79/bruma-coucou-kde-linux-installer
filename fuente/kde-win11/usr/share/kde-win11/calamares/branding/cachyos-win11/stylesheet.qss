/* CachyOS con aspecto de Windows 11 (colores y formas de WinUI 3) */

QWidget {
    font-size: 14px;
    color: #1b1b1b;
}

#mainApp {
    background-color: #f9f9f9;
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* Botones */
QPushButton {
    background-color: #fdfdfd;
    border: 1px solid #d5d5d5;
    border-bottom-color: #c2c2c2;
    border-radius: 4px;
    padding: 6px 18px;
    min-width: 90px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #f6f6f6;
}
QPushButton:pressed {
    background-color: #f0f0f0;
    color: #5f5f5f;
}
QPushButton:disabled {
    color: #a0a0a0;
    background-color: #f5f5f5;
    border-color: #e5e5e5;
}

/* Botón principal azul, como "Siguiente" en la instalación de Windows */
#view-button-next {
    background-color: #0067c0;
    color: #ffffff;
    border: 1px solid #0060b4;
    border-bottom-color: #003e92;
    min-width: 110px;
}
#view-button-next:hover {
    background-color: #1975c5;
}
#view-button-next:pressed {
    background-color: #3183ca;
    color: #e6f0fa;
}
#view-button-next:disabled {
    background-color: #c5c5c5;
    color: #ffffff;
    border-color: #c5c5c5;
}

#view-button-cancel {
    background-color: transparent;
    border-color: transparent;
}
#view-button-cancel:hover {
    background-color: #ececec;
}

#debugButton {
    background-color: none;
    font-size: 8px;
    height: 32px;
    padding: 0px;
    border: none;
}
#aboutButton {
    background-color: none;
    border: none;
}

/* Campos de texto y desplegables: borde inferior que se pone azul al enfocar */
QLineEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #e3e3e3;
    border-bottom: 1px solid #8a8a8a;
    border-radius: 4px;
    padding: 5px 10px;
    min-height: 22px;
    selection-background-color: #0067c0;
}
QLineEdit:hover, QComboBox:hover {
    background-color: #fafafa;
}
QLineEdit:focus, QComboBox:focus {
    border-bottom: 2px solid #0067c0;
}
QComboBox::drop-down {
    border: none;
    width: 28px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e3e3e3;
    border-radius: 6px;
    selection-background-color: #e5effa;
    selection-color: #1b1b1b;
    padding: 4px;
}

/* Listas (bootloader, escritorio, distribución de teclado, paquetes):
   tarjetas blancas con elementos altos y selección suave */
QListView, QTreeView, QTableView, QListWidget, QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    alternate-background-color: #ffffff;
}
QListView::item, QListWidget::item {
    min-height: 34px;
    padding-left: 10px;
    border-radius: 4px;
    margin: 1px 2px;
}
QTreeView::item, QTreeWidget::item {
    min-height: 30px;
    border-radius: 4px;
}
QListView::item:hover, QTreeView::item:hover, QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #f3f6fa;
}
QListView::item:selected, QTreeView::item:selected, QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #e5effa;
    color: #003e92;
}
QHeaderView::section {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e5e5e5;
    padding: 6px 8px;
    font-weight: 600;
    color: #5f6368;
}

QCheckBox, QRadioButton {
    spacing: 8px;
}

/* Barras de desplazamiento finas */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #b8b8b8;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #8a8a8a;
}
QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    height: 0;
    width: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #b8b8b8;
    border-radius: 3px;
    min-width: 30px;
}

QProgressBar {
    background-color: #e5e5e5;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #0067c0;
    border-radius: 2px;
}

QToolTip {
    background-color: #f9f9f9;
    color: #1b1b1b;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    padding: 4px 8px;
}

/* Partición: barra de previsualización y tarjetas de opciones */
#partitionBarView, #partitionLabelsView {
    background-color: transparent;
}

/* Paso "Arranque" (y cualquier selector con vista previa): título grande como en la instalación
   de Windows, opciones altas y texto explicativo en gris oscuro */
#products::item {
    min-height: 44px;
    padding-left: 12px;
}
#productName {
    font-size: 22px;
    font-weight: 600;
    color: #1b1b1b;
    padding: 2px 0px 6px 2px;
}
#productDescription {
    font-size: 14px;
    color: #3b3b3b;
    padding: 8px 2px 0px 2px;
}

/* Fondos que el tema no pintaba: con el tema oscuro de la sesión en vivo quedaban negros con el
   texto oscuro encima (recuadro del Resumen, mensaje "¿Instalar ahora?", detalles de la instalación) */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}
QDialog, QMessageBox {
    background-color: #f9f9f9;
}
QMessageBox QLabel, QDialog QLabel {
    color: #1b1b1b;
    background-color: transparent;
}
QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #ffffff;
    color: #1b1b1b;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    selection-background-color: #0067c0;
    selection-color: #ffffff;
}
QToolButton {
    background-color: #fdfdfd;
    color: #1b1b1b;
    border: 1px solid #d5d5d5;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: #f6f6f6;
}
QMenu {
    background-color: #ffffff;
    color: #1b1b1b;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item:selected {
    background-color: #e5effa;
    color: #003e92;
}
QGroupBox, QFrame, QTabWidget::pane {
    color: #1b1b1b;
}
